# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: docker compose reads "KEY=   # note" as the value "# note".

# Inside docker compose the backend always uses db:5432. For host-side tools (alembic,
# scripts, pytest) the compose Postgres is published on localhost:5433.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/wallet_risk

ETHERSCAN_API_KEY=
# Free tier per docs.etherscan.io/rate-limits (checked 2026-09): 3 calls/s, 100k calls/day.
ETHERSCAN_RATE_LIMIT_PER_SEC=3
# Send at this fraction of the limit; network jitter bunches evenly spaced requests.
ETHERSCAN_RATE_HEADROOM=0.8

# Alchemy API key (free tier) for ERC-20 balances: dashboard.alchemy.com -> app -> Ethereum Mainnet.
BALANCES_API_KEY=
# Unused: prices come from DefiLlama, which needs no key.
PRICE_API_KEY=

CACHE_TTL_SECONDS=3600
# Scoring jobs: timeout, concurrency (they share one Etherscan rate limit), result reuse.
SCORE_JOB_TIMEOUT_SECONDS=300
SCORE_MAX_CONCURRENT_JOBS=2
SCORE_REUSE_SECONDS=3600
# Portfolio: in-memory cache TTL for balances/prices, and how many tokens to list.
PORTFOLIO_CACHE_SECONDS=300
PORTFOLIO_TOP_N=20
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
