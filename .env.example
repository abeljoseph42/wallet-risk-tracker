# Copy to .env and fill in. Never commit .env.
# Inside docker compose the backend always uses db:5432. For host-side tools (alembic,
# scripts, pytest) the compose Postgres is published on localhost:5433.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/wallet_risk
ETHERSCAN_API_KEY=
ETHERSCAN_RATE_LIMIT_PER_SEC=3       # free tier, docs.etherscan.io/rate-limits (checked 2026-09)
BALANCES_API_KEY=                    # only if Phase 7 adds a provider
PRICE_API_KEY=                       # optional
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
